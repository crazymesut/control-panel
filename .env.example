# Copy to .env and edit before installation.
# Kurulumdan önce .env olarak kopyalayıp düzenleyin.
# setup.sh does not load this file automatically; see README.
# setup.sh bu dosyayı otomatik yüklemez; README'ye bakın.

PANEL_ADMIN=admin
PANEL_EMAIL=admin@example.com
PANEL_PORT=8765

# Leave empty to generate a random password during setup.
# Kurulumda rastgele şifre oluşturulması için boş bırakın.
# Quote custom passwords with single quotes when sourcing this file in Bash.
# Bash ile yüklerken özel şifreleri tek tırnak içine alın.
PANEL_PASSWORD=

# Runtime only: setup.sh calculates this as PANEL_PORT + 10000.
# Yalnızca çalışma zamanı: setup.sh bunu PANEL_PORT + 10000 olarak hesaplar.
# PANEL_PORT_INTERNAL=18765
